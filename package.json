{
  "name": "sap-battle-engine-bug-squisher",
  "version": "1.0.0",
  "description": "Browser SAP replay capture and evidence-based battle-engine diagnosis",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "build:ocr": "mkdir -p .scratch && swiftc -module-cache-path .scratch/swift-cache scripts/ocr.swift -o .scratch/sap-ocr",
    "diagnose": "node src/cli.mjs diagnose",
    "capture": "node --env-file=.env src/cli.mjs capture",
    "pipeline": "node --env-file=.env src/cli.mjs run",
    "pipeline:all": "node --env-file=.env scripts/run-all-scenarios.mjs"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "playwright": "^1.63.0",
    "sap-battle-engine": "github:lgtyqz/sap-battle-engine#be1e7e0e3b8a741a4abaeb5c1bbd1e356f9f9f67",
    "sharp": "^0.35.4"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.12"
  }
}
